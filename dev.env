# Local development. Variables already set in the environment override these.
HEALTH_PORT=8083
# Work already started may continue this long after a stop signal.
SHUTDOWN_GRACE=30s
# Name of this worker in claims; empty = the host name (the pod name in Kubernetes).
WORKER_ID=worker-request-local

# Integrator.Api (halyk-genai-integrator).
INTEGRATOR_URL=http://localhost:8080
INTEGRATOR_TIMEOUT=10s
# A call that cannot reach the API (network error, 502/503/504) is tried again 3 times, 500ms apart.
INTEGRATOR_RETRIES=3
INTEGRATOR_RETRY_DELAY=500ms

# After a round without work a loop waits 1s, doubling up to 10s.
LOOP_IDLE_DELAY=1s
LOOP_MAX_IDLE_DELAY=10s

# Copying documents Attstore → S3: 4 claimed per round, 2 copied at once,
# claim renewed every 15s (lease is 60s), one copy may take up to 10 minutes.
DOCUMENT_BATCH_SIZE=4
DOCUMENT_WORKERS=2
DOCUMENT_RENEW_EVERY=15s
DOCUMENT_MAX_COPY_DURATION=10m
# 512 MiB, the AI team's file limit.
DOCUMENT_MAX_BYTES=536870912
SOURCE_HEADER_TIMEOUT=30s

# Where document copies for AI are stored: local MinIO (infra).
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_BUCKET=bpm-bucket
AWS_ACCESS_KEY_ID=43DJ0H0NJ5IQEKRBSOLA
AWS_SECRET_ACCESS_KEY=A4m6jJROT5BEAiUa1EcMPA6zvabuSNHYLEG4gim8
# Multipart chunk: 16 MiB. Memory for copies ≈ DOCUMENT_WORKERS × S3_PART_SIZE.
S3_PART_SIZE=16777216
